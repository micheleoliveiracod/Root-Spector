LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# Fallback opcional (Groq -> Gemini -> Anthropic -> OpenAI, nessa ordem),
# ver config.py::get_llm(). Cada linha só entra na cadeia de fallback se a
# respectiva chave estiver preenchida -- deixar tudo em branco (cenário
# mínimo de testes/prototipagem, só com o Groq gratuito) é válido e não
# quebra nada.

# Gemini -- 2º provedor gratuito. Cota diária estreita (20
# requisições/dia por modelo no tier gratuito), por isso entra como
# fallback e não como principal. Chave em https://aistudio.google.com
GOOGLE_API_KEY=
LLM_FALLBACK_GEMINI_MODEL=gemini-2.5-flash

# Reforço pago (opcional, ex: pra demonstração) -- não é necessário pra
# rodar/testar o agente localmente.
ANTHROPIC_API_KEY=
LLM_FALLBACK_ANTHROPIC_MODEL=claude-3-5-haiku-latest
OPENAI_API_KEY=
LLM_FALLBACK_OPENAI_MODEL=gpt-4o-mini

# BIOTECPREDICT_DB_PATH aponta pro arquivo SQLite exportado do BiotecPredict
# (schema real), colocado manualmente em data/. Nunca versionar esse arquivo.
BIOTECPREDICT_DB_PATH=data/biotecpredict.db

# CORS_ALLOWED_ORIGINS restringe quais origens podem chamar a API
# (backend/main.py). "*" (padrão) libera qualquer origem, adequado só pra
# desenvolvimento local. Em produção, lista separada por vírgula, ex:
# https://app.exemplo.com,https://outro-dominio.com
CORS_ALLOWED_ORIGINS=*

# INTERNAL_API_KEY, opcional, deixar em branco em desenvolvimento local.
# Sem essa variável, nenhuma chave é exigida. Quando definida, as rotas de
# lotes, investigações e resumo diário passam a exigir o cabeçalho
# `X-API-Key` com o mesmo valor (backend/main.py::exigir_api_key); o
# frontend e o workflow n8n precisam enviar esse cabeçalho em produção.
# `relatorio.pdf` e `/reports` ficam de fora dessa exigência, o link do
# relatório precisa continuar clicável direto do e-mail.
INTERNAL_API_KEY=

# Observabilidade, sinal 2 (docs/OBSERVABILIDADE.md) -- opcional, desligado
# por padrão. Ativar manda a conversa completa (mensagens, prompts,
# respostas do LLM) pro LangSmith, decisão consciente, não um default
# silencioso. Lido diretamente pelo langsmith/langchain-core a partir do
# ambiente, sem código adicional em config.py. Chave e projeto em
# https://smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=root-spector

# DATABASE_URL, opcional, deixar em branco em desenvolvimento local. Sem
# essa variável, o checkpointer do LangGraph (graph.py) e o log
# estruturado em banco (config.py) usam SQLite local, em data/. Quando
# definida (deploy, Azure Database for PostgreSQL), os dois passam a usar
# a mesma instância de Postgres, ver specs/deploy-producao/plano.md.
# Exemplo: postgresql://usuario:senha@host:5432/banco
DATABASE_URL=
