__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/
.env
.env.local
frontend/.env.local
.coverage

# configuração local do Claude Code (worktrees, sessão), não faz parte do projeto
.claude/

# bancos locais gerados em runtime: checkpoints.db (estado do LangGraph)
# e observabilidade.db (log estruturado em banco, Fase 2, ver
# root_cause_agent/config.py::OBSERVABILIDADE_DB_PATH). Nunca commitar.
# data/biotecpredict.db é a exceção: dados sintéticos curados (ver
# data/simulacao_causa_raiz/README.md), versionado de propósito para
# embarcar automaticamente no deploy.
data/*.db
data/*.db-*
!data/.gitkeep
!data/biotecpredict.db

# relatórios gerados em runtime (mantém a pasta versionada via .gitkeep)
reports/*
!reports/.gitkeep

# frontend (React + Vite)
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
frontend/tsconfig.tsbuildinfo
npm-debug.log*

# e2e (Playwright) -- checkpoint do LangGraph gerado em runtime pelo webServer
tests/data/
tests/e2e/node_modules/
tests/e2e/test-results/
tests/e2e/playwright-report/
tests/e2e/.cache/

# material de avaliação da disciplina, não faz parte do código do projeto
escopo-avaliacao/
